# ── Supabase ───────────────────────────────────────────────────────────────────
# Project Settings → API u Supabase dashboard-u.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# "anon public" kljuc — sme u browser, koristi ga sajt za citanje objavljenih clanaka.
SUPABASE_ANON_KEY=
# "service_role" kljuc — PUN PRISTUP BAZI, zaobilazi RLS.
# Iskljucivo u GitHub Secrets i Vercel env varijablama. Nikad u kodu, nikad u browseru.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Faza 5) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram (Faza 7) ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Tvoj licni chat ID — bot salje draftove samo tu.
TELEGRAM_CHAT_ID=
# Nasumican string koji Telegram vraca u zaglavlju webhook zahteva, da ruta
# odbije zahteve koji ne dolaze od Telegrama.
TELEGRAM_WEBHOOK_SECRET=

# ── Sajt ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ainovine.rs

# ── Pipeline (opciono) ─────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
